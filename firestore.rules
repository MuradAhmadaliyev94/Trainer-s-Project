rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.email == 't1@trainers.app'; }
    function isSelf(id) { return signedIn() && request.auth.token.email == id + '@trainers.app'; }

    // Each trainer's own cabinet data: readable by any signed-in trainer,
    // writable by the owner or the admin (t1).
    match /trainers/{id} {
      allow read: if signedIn();
      allow write: if isSelf(id) || isAdmin();
    }

    // Shared collections: any signed-in trainer
    match /{col}/{doc} {
      allow read, write: if signedIn()
        && col in ['bookings','messages','presence','meetings',
                   'vesdocs','veschunks','katfiles','katchunks'];
    }
  }
}